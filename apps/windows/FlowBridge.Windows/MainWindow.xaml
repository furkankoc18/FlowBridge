<Window x:Class="FlowBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FlowBridge.Windows.Models"
        Title="FlowBridge" Width="1000" Height="680" MinWidth="860" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}"
        Icon="FlowBridge.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172033">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,8,4,28">
                        <Border Width="42" Height="42" Background="#5965E8" CornerRadius="11">
                            <TextBlock Text="↔" Foreground="White" FontSize="25"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,2,0,0">
                            <TextBlock Text="FlowBridge" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="macOS + Windows" Foreground="#9EA8BD" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#4CD27D" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DiscoveryStatus}" Foreground="#DCE3F0" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="{Binding DeviceName}" Foreground="#8792A8" FontSize="11" Margin="16,5,0,0" />
                </StackPanel>

                <StackPanel VerticalAlignment="Top">
                    <Button Content="Genel Bakış" Tag="OverviewPanel" Click="Navigate_Click" Margin="0,0,0,8" />
                    <Button Content="Cihazlar" Tag="DevicesPanel" Click="Navigate_Click" Margin="0,0,0,8" />
                    <Button Content="Gizlilik" Tag="PrivacyPanel" Click="Navigate_Click" Margin="0,0,0,8" />
                    <Button Content="Teşhis" Tag="DiagnosticsPanel" Click="Navigate_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Tek masa. İki bilgisayar." FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="İki PC'yi veya PC ile Mac'i güvenli yerel bağlantıda tek fareyle kullan."
                               Foreground="{StaticResource SecondaryText}" FontSize="16" Margin="0,7,0,24" />

                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="YAKINDAKİ CİHAZ" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                                <TextBlock Text="{Binding PeerCount}" FontSize="26" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="GİRİŞ KATMANI" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                                <TextBlock Text="Hazır" Foreground="#249D58" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="GÜVENLİ BAĞLANTI" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                                <TextBlock Text="AES-GCM" Foreground="#287DBA" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="FlowBridge Windows · 0.4.0" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Bu bilgisayar aynı ağdaki FlowBridge cihazlarını arıyor."
                                           Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding RunningAction}" Click="ToggleRunning_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Ortak fare" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MouseSharingDetail}" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Bu Windows cihazı" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                            <TextBlock Text="{Binding DeviceName}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding ShortDeviceId, StringFormat={}Kimlik {0}}"
                                       Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="DevicesPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Cihazlar" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="Aynı ağdaki FlowBridge cihazları otomatik görünür."
                               Foreground="{StaticResource SecondaryText}" FontSize="15" Margin="0,6,0,22" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Peers}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PeerDevice}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <Grid Width="650">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding ActionTitle}" Click="PeerAction_Click"
                                            Style="{StaticResource PrimaryButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="Başka bir Mac veya Windows cihazında FlowBridge'i açın."
                           Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PeerCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                <TextBlock Text="Gizlilik" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Paylaşım denetimi sende kalır; içerik buluta gönderilmez."
                           Foreground="{StaticResource SecondaryText}" FontSize="15" Margin="0,6,0,22" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="Pano paylaşımı (gelecek sürüm)" IsChecked="False" IsEnabled="False"
                                  FontSize="15" Margin="0,0,0,18" />
                        <Separator />
                        <Grid Margin="0,18,0,0">
                            <TextBlock Text="Bu sürüm yalnızca fare hareketi, tıklama ve kaydırma paylaşır." VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed">
                <TextBlock Text="Teşhis" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Bağlantı durumunu kişisel veri toplamadan kontrol et."
                           Foreground="{StaticResource SecondaryText}" FontSize="15" Margin="0,6,0,22" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Yerel ağ keşfi" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DiscoveryStatus}" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,16" />
                        <Separator />
                        <Grid Margin="0,16,0,16">
                            <StackPanel>
                                <TextBlock Text="Windows Güvenlik Duvarı" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FirewallStatus}" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Content="Özel ağ izni ver" Click="ConfigureFirewall_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Separator />
                        <TextBlock Text="Windows giriş API'leri" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="Çift yönlü hook ve SendInput katmanı hazır" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,16" />
                        <Separator />
                        <TextBlock Text="Taşıma güvenliği" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="AES-256-GCM fare paketleri + HMAC denetim mesajları" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
